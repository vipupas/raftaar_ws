{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(colcon build:*)",
      "Bash(colcon test:*)",
      "Bash(colcon test-result:*)",
      "Bash(colcon list:*)",
      "Bash(colcon graph:*)",
      "Bash(rosdep check:*)",
      "Bash(rosdep install:*)",
      "Bash(rosdep update:*)",
      "Bash(ros2 pkg:*)",
      "Bash(ros2 interface:*)",
      "Bash(ros2 doctor:*)",
      "Bash(ros2 topic list:*)",
      "Bash(ros2 topic info:*)",
      "Bash(ros2 topic type:*)",
      "Bash(ros2 topic hz:*)",
      "Bash(ros2 topic bw:*)",
      "Bash(ros2 topic echo:*)",
      "Bash(ros2 node list:*)",
      "Bash(ros2 node info:*)",
      "Bash(ros2 param list:*)",
      "Bash(ros2 param get:*)",
      "Bash(ros2 param dump:*)",
      "Bash(ros2 service list:*)",
      "Bash(ros2 service type:*)",
      "Bash(ros2 action list:*)",
      "Bash(ros2 action info:*)",
      "Bash(ros2 lifecycle list:*)",
      "Bash(ros2 lifecycle nodes:*)",
      "Bash(ros2 lifecycle get:*)",
      "Bash(ros2 bag info:*)",
      "Bash(ament_flake8:*)",
      "Bash(ament_pep257:*)",
      "Bash(ament_xmllint:*)",
      "Bash(ament_copyright:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python -m pyflakes:*)",
      "Bash(python3 -m pyflakes:*)",
      "Bash(python -m compileall:*)",
      "Bash(python3 -m compileall:*)",
      "Bash(wsl --list:*)",
      "Bash(wsl --status:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "WebFetch(domain:docs.ros.org)",
      "WebFetch(domain:navigation.ros.org)",
      "WebFetch(domain:design.ros2.org)",
      "WebFetch(domain:ardupilot.org)",
      "WebFetch(domain:mavlink.io)",
      "Read"
    ],
    "ask": [
      "Bash(ros2 topic pub:*)",
      "Bash(ros2 service call:*)",
      "Bash(ros2 param set:*)",
      "Bash(ros2 action send_goal:*)",
      "Bash(ros2 lifecycle set:*)",
      "Bash(ros2 run:*)",
      "Bash(ros2 launch:*)",
      "Bash(ros2 bag play:*)",
      "Bash(git push:*)",
      "Bash(rm -rf build*)",
      "Bash(rm -rf install*)",
      "Bash(rm -rf log*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)"
    ]
  }
}
